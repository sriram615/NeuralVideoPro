# Vector Store Path
QDRANT_DB_PATH=./data/vectors/qdrant_db

# FastAPI Backend Configuration
HOST=0.0.0.0
PORT=8000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Static keyframe directory served at /static/frames
# (default: ./data/processed/extracted_frames_v2). Point this at the extraction
# directory that matches your indexed vectors when they are not the same.
# STATIC_FRAMES_DIR=./data/processed/extracted_frames_v2
